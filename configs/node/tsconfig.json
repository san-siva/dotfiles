{
    "$schema": "http://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "allowJs": true,
        "types": ["jest", "node", "react"]
    },
    "include": [
        "./src/**/*.ts",
        "./src/**/*.tsx",
        "./src/**/*.test.ts",
        "./src/**/*.test.tsx",
        "./src/**/*.spec.ts",
        "./src/**/*.spec.tsx"
    ]
}
