;; Kanata config — keyboard remapping for macOS
;;
;; Swap Caps Lock <-> Left Control globally.
;; Block the Logitech MX Keys Mini lock macro (physical lctl+lmet+q),
;; which after the swap would otherwise fire as caps+cmd+q and quit apps.

(defsrc
  caps lctl lmet q
)

(deflayer default
  lctl caps lmet q
)

(defoverrides
  (caps lmet q) (nop0)
)
