[user]
	email = your.work.email@company.com
	name = Your Name
	signingkey = /path/to/.ssh/work_signing_key.pub
[pull]
	rebase = false
[commit]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /path/to/.ssh/allowed_signers

# URL rewriting: Automatically use github-wrk SSH alias for all GitHub operations
# This ensures the correct SSH key is used for authentication and commit signing
# Only applies to repositories in the work directory path specified in .gitconfig
[url "git@github-wrk:"]
	insteadOf = git@github.com:
	insteadOf = git@github-nexthink:
