#!/usr/bin/env bash

# Author: Santhosh Siva
# Date Created: 18-06-2026

# Description:
# Lists all available Kubernetes cluster contexts
# (wraps `kubectl config get-contexts -o name`).

source "$(dirname "${BASH_SOURCE[0]}")/../utils.sh"

set_flags() {
	while [ $# -gt 0 ]; do
		case "$1" in
		-h | --help)
			echo "k-clusters - list all Kubernetes cluster contexts"
			echo " "
			echo "k-clusters [options]"
			echo " "
			echo "options:"
			echo "-h, --help        show brief help"
			exit 0
			;;
		*)
			echo "${RED}Unknown option:${NC} $1"
			exit 1
			;;
		esac
		shift
	done
}

list_clusters() {
	local step_number=$1

	if [ -z "$step_number" ]; then
		step_number=0
	fi

	print_message "${BLUE}Listing cluster contexts...${NC}" $step_number

	if ! kubectl config get-contexts -o name 2>&1 | indent; then
		print_message "" -1
		print_message "${RED}Failed to list cluster contexts. [Fail]${NC}" -1
		exit 1
	fi

	print_message "${GREEN}Listed cluster contexts. [DONE]${NC}"
	return 0
}

main() {
	set_flags "$@"
	validate_dependencies kubectl
	print_banner

	list_clusters 1
}

# Only run main if script is executed directly (not sourced)
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
	main "$@"
	exit 0
fi
