#!/usr/bin/env bash

# Author: Santhosh Siva
# Date Created: 15-12-2025

# Description:
# Links the ssh config and sets up the SSH agent. Run it to link the config;
# ~/.zshrc sources it on every shell start to load the agent and keys silently,
# only printing errors.

link_ssh_config() {
	link ~/.config/configs/ssh/ssh_config ~/.ssh/config
}

setup_ssh_agent() {
    # Start ssh-agent silently
    if ! eval $(ssh-agent) >/dev/null 2>&1; then
        echo "Warning: Failed to start ssh-agent" >&2
        return 1
    fi

    # Array of SSH keys to add
    local ssh_keys=(
        "$HOME/.ssh/san_siva__personal"
        "$HOME/.ssh/san_siva__wrk"
        "$HOME/.ssh/san_siva__wrk_signing_key"
    )

    # Add each key if it exists
    for key in "${ssh_keys[@]}"; do
        if [ -f "$key" ]; then
            if ! ssh-add "$key" >/dev/null 2>&1; then
                echo "Warning: Failed to add SSH key: $key" >&2
            fi
        fi
    done
}

main() {
	source "$(dirname "${BASH_SOURCE[0]}")/../utils.sh"

	echo "Sankit"
	echo ""

	link_ssh_config
}

# Sourced from zsh: only load the agent (and never exit the shell)
if [ -n "$ZSH_VERSION" ] || [ "${BASH_SOURCE[0]}" != "$0" ]; then
	setup_ssh_agent
else
	main "$@"
	exit 0
fi
