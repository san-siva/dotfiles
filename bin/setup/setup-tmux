# Description:
# Installs tmux and the Tmux Plugin Manager.

source "$(dirname "${BASH_SOURCE[0]}")/../utils.sh"

install_tmux() {
	brew_install tmux

	if [ -d "$HOME/.tmux/plugins/tpm" ]; then
		echo 'Tmux Plugin Manager already installed'
	else
		echo 'Installing Tmux Plugin Manager'
		git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
	fi
}

link_tmux_config() {
	link ~/.config/configs/tmux/.tmux.conf ~/.tmux.conf
}

main() {
	echo "Sankit"
	echo ""

	load_brew
	install_tmux
	link_tmux_config
}

main "$@"
exit 0
