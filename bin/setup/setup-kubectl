# Description:
# Installs the Kubernetes command line tooling.

source "$(dirname "${BASH_SOURCE[0]}")/../utils.sh"

install_kubectl() {
	brew_install kubectl kubernetes-cli
}

install_flux() {
	# Flux CD (Kubernetes GitOps tooling)
	brew_install flux fluxcd/tap/flux
}

main() {
	echo "Sankit"
	echo ""

	load_brew
	install_kubectl
	install_flux
}

main "$@"
exit 0
