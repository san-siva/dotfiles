#!/usr/bin/env bash

# Author: Santhosh Siva
# Date Created: 17-12-2025

# Description:
# This script reinstalls the @anthropic-ai/claude-code package.

source "$(dirname "${BASH_SOURCE[0]}")/../utils.sh"

get_claude_dir() {
	claude_dir=$(npm root -g)/@anthropic-ai/claude-code
	echo "$claude_dir"
}

stop_claude_processes() {
	local pids=$(pgrep -x claude 2>/dev/null)
	if [ -z "$pids" ]; then
		print_message "${YELLOW}No Claude processes found${NC}" 0
		return 0
	fi

	local count=$(echo "$pids" | wc -l | tr -d ' ')
	print_message "${YELLOW}Found $count Claude process(es) running${NC}" 0
	echo -e "${YELLOW}Stopping Claude is required to proceed with reinstallation.${NC}"
	read -p "Do you want to stop all Claude processes? (y/n): " -n 1 -r
	echo

	if [[ ! $REPLY =~ ^[Yy]$ ]]; then
		print_message "${RED}User cancelled. Cannot proceed with reinstallation.${NC}" 0
		exit 1
	fi

	print_message "${BLUE}Stopping Claude processes...${NC}" 1
	pkill -x claude 2>/dev/null
	sleep 1

	# Check if any processes are still running
	if pgrep -x claude >/dev/null 2>&1; then
		print_message "${YELLOW}Force killing remaining Claude processes...${NC}" 0
		pkill -9 -x claude 2>/dev/null
		sleep 1
	fi

	if ! pgrep -x claude >/dev/null 2>&1; then
		print_message "${GREEN}All Claude processes stopped${NC}" 2
		return 0
	else
		print_message "${RED}Failed to stop all Claude processes${NC}" 0
		return 1
	fi
}

clear_npm_cache() {
	if (npm cache clean --force >/dev/null 2>&1); then
		print_message "${GREEN}Cleared npm cache${NC}" 2
		return 0
	fi
	print_message "${YELLOW}Failed to clear npm cache${NC}" 0
	return 1
}

try_uninstall() {
	if (npm uninstall -g @anthropic-ai/claude-code >/dev/null 2>&1); then
		print_message "${GREEN}Uninstalled successfully${NC}" 2
		return 0
	fi
	print_message "${RED}Failed to uninstall${NC}" 0
	return 1
}

try_force_uninstall() {
	if (npm uninstall -g --force @anthropic-ai/claude-code >/dev/null 2>&1); then
		print_message "${GREEN}Force uninstalled successfully${NC}" 2
		return 0
	fi
	print_message "${RED}Failed to force uninstall${NC}" 0
	return 1
}

try_removing_claude_from_bin() {
	claude_dir=$(get_claude_dir)
	if [ -d "$claude_dir" ]; then
		print_message "${GREEN}Removing claude from bin directory${NC}" 4
		rm -rf "$claude_dir"
		return 0
	fi
	print_message "${RED}Failed to remove claude from bin directory${NC}" 0
	return 1
}

try_installing_claude() {
	if (npm install -g @anthropic-ai/claude-code >/dev/null 2>&1); then
		print_message "${GREEN}Installed successfully${NC}" 6
		return 0
	fi
	return 1
}

main() {
	validate_dependencies figlet lolcat
	print_banner

	print_message "${BLUE}Stopping Claude processes...${NC}" 0
	stop_claude_processes

	print_message "${BLUE}Clearing npm cache...${NC}" 1
	clear_npm_cache

	print_message "${BLUE}Attempting to uninstall Claude Code...${NC}" 3

	if try_uninstall; then
		:
	elif try_force_uninstall; then
		:
	elif try_removing_claude_from_bin; then
		:
	else
		print_message "${RED}All uninstall methods failed. Proceeding with installation anyway...${NC}" 0
	fi

	print_message "${BLUE}Installing Claude Code...${NC}" 5
	if try_installing_claude; then
		print_message "${GREEN}Claude Code reinstalled successfully!${NC}" 7
		return 0
	else
		print_message "${RED}Failed to install Claude Code.${NC}" 0
		return 1
	fi
}

main "$@"
