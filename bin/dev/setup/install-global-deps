#!/usr/bin/env bash

# Author: Santhosh Siva
# Date Created: 15-12-2025

# Description:
# This script installs global dependencies for development environment.

install_npm_global_deps() {
	if ! [ -n "$(command -v npm)" ]; then
		echo "npm not found"
		echo "Attempting NVM Install"
		curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.3/install.sh | bash
		export NVM_DIR="$HOME/.nvm"
		[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
		nvm install --lts
		nvm install node
	fi

	if [ -n "$(command -v npm)" ]; then
		# ESLINT Core
		npm install -g \
			eslint \
			jiti \
			@eslint/js \
			@eslint/eslintrc \
			@eslint/compat \
			eslint_d

		# ESLINT Plugins
		npm install -g \
			eslint-plugin-react \
			eslint-plugin-react-native \
			eslint-plugin-react-hooks \
			eslint-plugin-jest \
			eslint-plugin-import \
			eslint-plugin-jsx-a11y \
			eslint-plugin-no-await-in-promise \
			eslint-plugin-redux-saga \
			@jambit/eslint-plugin-typed-redux-saga \
			eslint-plugin-simple-import-sort \
			eslint-plugin-unicorn

		# Markdown
		npm install -g \
			markdownlint-cli2

		# Jest
		npm install -g \
			jest

		# TypeScript
		npm install -g \
			typescript \
			typescript-eslint \
			@typescript-eslint/eslint-plugin \
			@typescript-eslint/parser

		# Prettier
		npm install -g \
			prettier \
			eslint-config-prettier

		# Utils
		npm install -g \
			local-ssl-proxy \
			neovim

		# Git Workflow Tools
		npm install -g \
			@san-siva/gitsy

		# Claude Code
		npm install -g \
			@anthropic-ai/claude-code

		# MCP Servers
		npm install -g \
			chrome-devtools-mcp
	else
		echo "npm still not available after installation attempt"
	fi
}

install_eslint_configs() {
	if ! [ -n "$(command -v npm)" ]; then
		echo "npm not found, skipping eslint config installation"
		return 1
	fi

	# Get npm global prefix
	NPM_GLOBAL=$(npm config get prefix)
	ESLINT_CONFIG_DIR="$NPM_GLOBAL/lib/eslint-configs"

	# Create directory for global eslint configs
	if [ ! -d "$ESLINT_CONFIG_DIR" ]; then
		echo "Creating global eslint configs directory at $ESLINT_CONFIG_DIR"
		mkdir -p "$ESLINT_CONFIG_DIR"
	fi

	# Remove existing files/symlinks if they exist
	if [ -L "$ESLINT_CONFIG_DIR/eslint.config.ts" ] || [ -f "$ESLINT_CONFIG_DIR/eslint.config.ts" ]; then
		rm -f "$ESLINT_CONFIG_DIR/eslint.config.ts"
	fi

	if [ -L "$ESLINT_CONFIG_DIR/eslint-utilities.ts" ] || [ -f "$ESLINT_CONFIG_DIR/eslint-utilities.ts" ]; then
		rm -f "$ESLINT_CONFIG_DIR/eslint-utilities.ts"
	fi

	# Create symlinks to eslint config files
	echo "Installing ESLint configs globally..."
	ln -s ~/.config/configs/eslint/eslint.config.ts "$ESLINT_CONFIG_DIR/eslint.config.ts"
	ln -s ~/.config/configs/eslint/eslint-utilities.ts "$ESLINT_CONFIG_DIR/eslint-utilities.ts"

	echo "ESLint configs symlinked to $ESLINT_CONFIG_DIR"
	echo "You can import them in your projects:"
	echo "  import config from '$ESLINT_CONFIG_DIR/eslint.config.ts';"
}

install_bash_formatter() {
	if ! [ -n "$(command -v pip3)" ]; then
		echo "pip3 not found, skipping bash formatter installation"
		return 1
	fi

	pip3 install --user beautysh pynvim yamlfix shandy-sqlfmt
}

install_brew_packages() {
	if ! [ -n "$(command -v brew)" ]; then
		echo "brew not found, skipping brew package installation"
		return 1
	fi

	brew install deno fish ripgrep fzf fd tmux mkcert nss ruby zoxide jq yq gh black wget fastfetch figlet lolcat

	# Karabiner-Elements provides the VirtualHIDDevice driver required by kanata.
	# The app itself is not used — install it once to activate the system extension,
	# grant Input Monitoring permission when prompted, then quit it.
	brew install --cask karabiner-elements

	# Optional: Uncomment to setup mkcert
	# mkcert -install
	# mkcert localhost

	# Install TPM if not already installed
	if ! [ -d "$HOME/.tmux/plugins/tpm" ]; then
		git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm
	fi
}

install_ruby_deps() {
	if ! [ -n "$(command -v gem)" ]; then
		echo "gem not found, skipping ruby dependencies"
		return 1
	fi

	# Check Ruby version (need >= 3.0 for neovim gem)
	ruby_version=$(ruby -e 'puts RUBY_VERSION')
	ruby_major=$(echo "$ruby_version" | cut -d. -f1)

	if [ "$ruby_major" -lt 3 ]; then
		echo "Ruby version $ruby_version is too old (need >= 3.0)"
		echo "Homebrew Ruby should be installed, but you may need to restart your shell"
		echo "After restarting, run this script again to install ruby dependencies"
		return 1
	fi

	gem install --user-install neovim
}

enable_corepack() {
	if ! [ -n "$(command -v corepack)" ]; then
		echo "Corepack not found, yarn not enabled"
		return 1
	fi

	corepack enable
}

main() {
	echo "Sankit"
	echo ""
	echo "Installing global dependencies..."
	echo ""

	install_brew_packages
	install_bash_formatter
	install_npm_global_deps
	install_eslint_configs
	install_ruby_deps
	enable_corepack
}

main "$@"
exit 0
