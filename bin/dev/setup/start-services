#!/usr/bin/env bash

# Author: Santhosh Siva
# Date Created: 21-04-2026

# Description:
# Installs and starts background services required for the development environment.
# Safe to re-run — existing daemons are reloaded with updated config.

check_input_monitoring() {
	local bin="/opt/homebrew/bin/kanata"
	local tcc_db="/Library/Application Support/com.apple.TCC/TCC.db"

	local allowed
	allowed=$(sudo sqlite3 "$tcc_db" \
		"SELECT allowed FROM access WHERE service='kTCCServiceListenEvent' AND client='$bin';" 2>/dev/null)

	if [ "$allowed" = "1" ]; then
		echo "Input Monitoring: granted"
		return 0
	else
		echo "WARNING: Input Monitoring not granted for kanata"
		echo "  System Settings → Privacy & Security → Input Monitoring"
		echo "  Click + → Cmd+Shift+G → /opt/homebrew/bin → select kanata"
		echo "  Then re-run: ~/.config/bin/dev/setup/start-services"
		return 1
	fi
}

start_kanata() {
	local src="$HOME/.config/configs/com.user.kanata.plist"
	local dst="/Library/LaunchDaemons/com.user.kanata.plist"

	echo "Installing Kanata LaunchDaemon..."
	sudo rm -f "$dst"
	sudo cp "$src" "$dst"
	sudo launchctl bootout system/com.user.kanata 2>/dev/null || true
	sudo launchctl bootstrap system "$dst"
	echo "Kanata started"
}

main() {
	echo "Sankit"
	echo ""
	echo "Starting services..."
	echo ""

	check_input_monitoring
	start_kanata

	echo ""
	echo "Services started!"
}

main "$@"
exit 0
