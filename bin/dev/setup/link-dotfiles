#!/usr/bin/env bash

# Author: Santhosh Siva
# Date Created: 15-12-2025

# Description:
# This script creates symlinks for dotfiles from ~/.config to the home directory.

main() {
	echo "Sankit"
	echo ""
	echo "Creating symlinks for dotfiles..."
	echo ""

	# removing existing config files (including broken symlinks)
	if [ -L ~/.tmux.conf ] || [ -f ~/.tmux.conf ]; then
		rm -f ~/.tmux.conf
	fi

	if [ -L ~/.vimrc ] || [ -f ~/.vimrc ]; then
		rm -f ~/.vimrc
	fi

	if [ -L ~/.prettierrc.json ] || [ -f ~/.prettierrc.json ]; then
		rm -f ~/.prettierrc.json
	fi

	if [ -L ~/.eslintrc.json ] || [ -f ~/.eslintrc.json ]; then
		rm -f ~/.eslintrc.json
	fi

	if [ -L ~/.eslintrc.js ] || [ -f ~/.eslintrc.js ]; then
		rm -f ~/.eslintrc.js
	fi

	if [ -L ~/.p10k.zsh ] || [ -f ~/.p10k.zsh ]; then
		rm -f ~/.p10k.zsh
	fi

	if [ -L ~/.gitconfig ] || [ -f ~/.gitconfig ]; then
		rm -f ~/.gitconfig
	fi

	if [ -L ~/.gitconfig__wrk ] || [ -f ~/.gitconfig__wrk ]; then
		rm -f ~/.gitconfig__wrk
	fi

	if [ -L ~/.gitignore__global ] || [ -f ~/.gitignore__global ]; then
		rm -f ~/.gitignore__global
	fi

	if [ -L ~/.local/share/eclipse/eclipse-java-google-style.xml ] || [ -f ~/.local/share/eclipse/eclipse-java-google-style.xml ]; then
		rm -f ~/.local/share/eclipse/eclipse-java-google-style.xml
	fi

	if [ -L ~/.local/share/eclipse/lombok.jar ] || [ -f ~/.local/share/eclipse/lombok.jar ]; then
		rm -f ~/.local/share/eclipse/lombok.jar
	fi

	if [ -L ~/.ssh/config ] || [ -f ~/.ssh/config ]; then
		rm -f ~/.ssh/config
	fi

	ln -s ~/.config/configs/.tmux.conf ~/.tmux.conf
	ln -s ~/.config/configs/.vimrc ~/.vimrc
	ln -s ~/.config/configs/.prettierrc.json ~/.prettierrc.json
	ln -s ~/.config/configs/.eslintrc.json ~/.eslintrc.json
	ln -s ~/.config/configs/.p10k.zsh ~/.p10k.zsh
	ln -s ~/.config/configs/.gitconfig ~/.gitconfig
	ln -s ~/.config/configs/.gitconfig__wrk ~/.gitconfig__wrk
	ln -s ~/.config/configs/.gitignore__global ~/.gitignore__global
	ln -s ~/.config/configs/ssh_config ~/.ssh/config
	ln -s ~/.config/configs/eclipse-java-google-style.xml ~/.local/share/eclipse/eclipse-java-google-style.xml
	ln -s ~/.config/configs/lombok.jar ~/.local/share/eclipse/lombok.jar

	git config --global core.excludesfile ~/.gitignore__global

	echo "Symlinks created successfully!"
}

main "$@"
exit 0
