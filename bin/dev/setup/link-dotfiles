#!/usr/bin/env bash

# Author: Santhosh Siva
# Date Created: 15-12-2025

# Description:
# This script creates symlinks for dotfiles from ~/.config to the home directory.

link() {
	local src=$1 dst=$2
	if [ -d "$dst" ] && [ ! -L "$dst" ]; then
		# ln -f can't replace a real directory; move it aside instead
		local backup="${dst}.bak-$(date +%Y%m%d%H%M%S)"
		echo "Moving existing directory $dst to $backup"
		mv "$dst" "$backup"
	fi
	ln -sfn "$src" "$dst"
}

link_shell_configs() {
	link ~/.config/configs/.tmux.conf ~/.tmux.conf
	link ~/.config/configs/.vimrc ~/.vimrc
	link ~/.config/configs/.p10k.zsh ~/.p10k.zsh
}

link_editor_configs() {
	link ~/.config/configs/.prettierrc.json ~/.prettierrc.json
	link ~/.config/configs/.eslintrc.json ~/.eslintrc.json
}

link_git_configs() {
	link ~/.config/configs/.gitconfig ~/.gitconfig
	link ~/.config/configs/.gitconfig__wrk ~/.gitconfig__wrk
	link ~/.config/configs/.gitignore__global ~/.gitignore__global
	git config --global core.excludesfile ~/.gitignore__global
}

link_ssh_config() {
	link ~/.config/configs/ssh_config ~/.ssh/config
}

link_eclipse_configs() {
	link ~/.config/configs/eclipse-java-google-style.xml ~/.local/share/eclipse/eclipse-java-google-style.xml
	link ~/.config/configs/lombok.jar ~/.local/share/eclipse/lombok.jar
}

link_agent_skills() {
	mkdir -p ~/.claude
	mkdir -p ~/.gemini
	mkdir -p ~/.gemini/antigravity-cli

	link ~/.config/configs/agent-skills ~/.claude/skills
	link ~/.config/configs/agent-skills ~/.gemini/antigravity-cli/skills

	link_work_agent_skills
}

# Private skills live outside this public repo; WORK_AGENT_SKILLS_DIR is set in ~/.zshrc.
# Each one is linked into configs/agent-skills (gitignored) so both agents pick it up.
link_work_agent_skills() {
	if [ -z "$WORK_AGENT_SKILLS_DIR" ] || [ ! -d "$WORK_AGENT_SKILLS_DIR" ]; then
		echo "WORK_AGENT_SKILLS_DIR not set or missing, skipping work agent skills"
		return
	fi

	ln -sfn "$WORK_AGENT_SKILLS_DIR"/* ~/.config/configs/agent-skills/
}

link_antigravity_keybindings() {
	mkdir -p ~/.gemini/antigravity-cli

	link ~/.config/configs/antigravity-keybindings.json ~/.gemini/antigravity-cli/keybindings.json
}


main() {
	echo "Sankit"
	echo ""
	echo "Creating symlinks for dotfiles..."
	echo ""

	link_shell_configs
	link_editor_configs
	link_git_configs
	link_ssh_config
	link_eclipse_configs
	link_agent_skills
	link_antigravity_keybindings

	echo "Symlinks created successfully!"
}

main "$@"
exit 0
