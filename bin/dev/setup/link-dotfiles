#!/usr/bin/env bash

# Author: Santhosh Siva
# Date Created: 15-12-2025

# Description:
# This script creates symlinks for dotfiles from ~/.config to the home directory.

link() {
	local src=$1 dst=$2
	[ -L "$dst" ] || [ -f "$dst" ] && rm -f "$dst"
	ln -s "$src" "$dst"
}

link_shell_configs() {
	link ~/.config/configs/.tmux.conf ~/.tmux.conf
	link ~/.config/configs/.vimrc ~/.vimrc
	link ~/.config/configs/.p10k.zsh ~/.p10k.zsh
}

link_editor_configs() {
	link ~/.config/configs/.prettierrc.json ~/.prettierrc.json
	link ~/.config/configs/.eslintrc.json ~/.eslintrc.json
}

link_git_configs() {
	link ~/.config/configs/.gitconfig ~/.gitconfig
	link ~/.config/configs/.gitconfig__wrk ~/.gitconfig__wrk
	link ~/.config/configs/.gitignore__global ~/.gitignore__global
	git config --global core.excludesfile ~/.gitignore__global
}

link_ssh_config() {
	link ~/.config/configs/ssh_config ~/.ssh/config
}

link_eclipse_configs() {
	link ~/.config/configs/eclipse-java-google-style.xml ~/.local/share/eclipse/eclipse-java-google-style.xml
	link ~/.config/configs/lombok.jar ~/.local/share/eclipse/lombok.jar
}



link_kanata() {
	mkdir -p ~/.config/kanata
	link ~/.config/configs/kanata.kbd ~/.config/kanata/kanata.kbd
}


main() {
	echo "Sankit"
	echo ""
	echo "Creating symlinks for dotfiles..."
	echo ""

	link_shell_configs
	link_editor_configs
	link_git_configs
	link_ssh_config
	link_eclipse_configs
	link_kanata

	echo "Symlinks created successfully!"
}

main "$@"
exit 0
