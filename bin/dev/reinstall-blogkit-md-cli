#!/usr/bin/env bash

# Author: Santhosh Siva
# Date Created: 21-03-2026

# Description:
# This script reinstalls/upgrades the @san-siva/blogkit-md-cli package.

source "$(dirname "${BASH_SOURCE[0]}")/../utils.sh"

get_blogkit_md_cli_dir() {
	blogkit_md_cli_dir=$(npm root -g)/@san-siva/blogkit-md-cli
	echo "$blogkit_md_cli_dir"
}

try_uninstall() {
	if (npm uninstall -g @san-siva/blogkit-md-cli >/dev/null 2>&1); then
		print_message "${GREEN}Uninstalled successfully${NC}" 2
		return 0
	fi
	print_message "${RED}Failed to uninstall${NC}" 0
	return 1
}

try_force_uninstall() {
	if (npm uninstall -g --force @san-siva/blogkit-md-cli >/dev/null 2>&1); then
		print_message "${GREEN}Force uninstalled successfully${NC}" 2
		return 0
	fi
	print_message "${RED}Failed to force uninstall${NC}" 0
	return 1
}

try_removing_blogkit_md_cli_from_bin() {
	blogkit_md_cli_dir=$(get_blogkit_md_cli_dir)
	if [ -d "$blogkit_md_cli_dir" ]; then
		print_message "${GREEN}Removing blogkit-md-cli from bin directory${NC}" 2
		rm -rf "$blogkit_md_cli_dir"
		return 0
	fi
	print_message "${RED}Failed to remove blogkit-md-cli from bin directory${NC}" 0
	return 1
}

try_installing_blogkit_md_cli() {
	if (npm install -g @san-siva/blogkit-md-cli >/dev/null 2>&1); then
		print_message "${GREEN}Installed successfully${NC}" 4
		return 0
	fi
	return 1
}

main() {
	validate_dependencies figlet lolcat
	print_banner

	print_message "${BLUE}Attempting to uninstall blogkit-md-cli...${NC}" 1

	if try_uninstall; then
		:
	elif try_force_uninstall; then
		:
	elif try_removing_blogkit_md_cli_from_bin; then
		:
	else
		print_message "${RED}All uninstall methods failed. Proceeding with installation anyway...${NC}" 0
	fi

	print_message "${BLUE}Installing blogkit-md-cli...${NC}" 3
	if try_installing_blogkit_md_cli; then
		print_message "${GREEN}blogkit-md-cli reinstalled successfully!${NC}" 5
		return 0
	else
		print_message "${RED}Failed to install blogkit-md-cli.${NC}" 0
		return 1
	fi
}

main "$@"
