#!/usr/bin/env bash

# Author: Santhosh Siva
# Date Created: 29-12-2025

# Description:
# This script reinstalls/upgrades the @san-siva/gitsy package.

source "$(dirname "${BASH_SOURCE[0]}")/../utils.sh"

get_gitsy_dir() {
	gitsy_dir=$(npm root -g)/@san-siva/gitsy
	echo "$gitsy_dir"
}

try_uninstall() {
	if (npm uninstall -g @san-siva/gitsy >/dev/null 2>&1); then
		print_message "${GREEN}Uninstalled successfully${NC}" 2
		return 0
	fi
	print_message "${RED}Failed to uninstall${NC}" 0
	return 1
}

try_force_uninstall() {
	if (npm uninstall -g --force @san-siva/gitsy >/dev/null 2>&1); then
		print_message "${GREEN}Force uninstalled successfully${NC}" 2
		return 0
	fi
	print_message "${RED}Failed to force uninstall${NC}" 0
	return 1
}

try_removing_gitsy_from_bin() {
	gitsy_dir=$(get_gitsy_dir)
	if [ -d "$gitsy_dir" ]; then
		print_message "${GREEN}Removing gitsy from bin directory${NC}" 2
		rm -rf "$gitsy_dir"
		return 0
	fi
	print_message "${RED}Failed to remove gitsy from bin directory${NC}" 0
	return 1
}

try_installing_gitsy() {
	if (npm install -g @san-siva/gitsy >/dev/null 2>&1); then
		print_message "${GREEN}Installed successfully${NC}" 4
		return 0
	fi
	return 1
}

main() {
	validate_dependencies figlet lolcat
	print_banner

	print_message "${BLUE}Attempting to uninstall Gitsy...${NC}" 1

	if try_uninstall; then
		:
	elif try_force_uninstall; then
		:
	elif try_removing_gitsy_from_bin; then
		:
	else
		print_message "${RED}All uninstall methods failed. Proceeding with installation anyway...${NC}" 0
	fi

	print_message "${BLUE}Installing Gitsy...${NC}" 3
	if try_installing_gitsy; then
		print_message "${GREEN}Gitsy reinstalled successfully!${NC}" 5
		return 0
	else
		print_message "${RED}Failed to install Gitsy.${NC}" 0
		return 1
	fi
}

main "$@"
